# Copy to .env and fill in real values. Never commit the filled file.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/teamboard?retryWrites=true&w=majority

# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# Comma separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173,https://your-username.github.io

# Optional: port (hosting providers usually set this for you)
PORT=5000

# Optional: only set if your host cannot resolve MongoDB Atlas SRV records
# DNS_SERVERS=8.8.8.8,8.8.4.4
